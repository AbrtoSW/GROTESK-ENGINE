//terrain build comp
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;

struct TerrainInstance {
    vec2  originXZ;
    vec2  uvOrigin;
    vec2  uvScale;
    float worldScale;
    float _pad;
};

struct VkDrawIndexedIndirectCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

// ---------- set = 0  (matches your vkCmdBindDescriptorSets firstSet = 0)
layout(set=0, binding=0, std430) readonly buffer TerrainBuf { TerrainInstance inst[]; } TI;
layout(set=0, binding=1, std430) writeonly buffer Draws { VkDrawIndexedIndirectCommand cmds[]; };
layout(set=0, binding=2, std430) buffer DrawCount { uint drawCount; };

layout(push_constant) uniform PC_TerrainBuild {
    uint firstIndex;
    uint indexCount;
    int  vertexOffset;
    uint tileCount;
} pc;

void main() {
    if (gl_GlobalInvocationID.x != 0) return;

    VkDrawIndexedIndirectCommand dc;
    dc.indexCount    = pc.indexCount;
    dc.instanceCount = pc.tileCount;   // all tiles as instances
    dc.firstIndex    = pc.firstIndex;
    dc.vertexOffset  = pc.vertexOffset;
    dc.firstInstance = 0;

    cmds[0] = dc;
    drawCount = 1;
}